# PostgreSQL / Docker Compose
POSTGRES_USER=root
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=diagram_app
POSTGRES_PORT=5432

# Spring Boot datasource values when the application runs on the host
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/diagram_app
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=secretpassword

# Authentication
JWT_SECRET=replace_with_a_long_random_secret